{
	"name": "alveolus",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@11.1.3",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"check": "biome check .",
		"check:fix": "biome check --write .",
		"test": "pnpm -r test",
		"typecheck": "pnpm -r typecheck",
		"build": "pnpm -r build",
		"context-map": "pnpm -r context-map",
		"docs:dev": "pnpm --filter @alveolus/docs dev",
		"docs:build": "pnpm --filter @alveolus/docs build"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15"
	}
}
