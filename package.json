{
	"name": "alveolus",
	"private": true,
	"type": "module",
	"scripts": {
		"check": "oxfmt --check && eslint . --max-warnings 0",
		"check:fix": "oxfmt && eslint . --fix",
		"test": "pnpm -r test",
		"typecheck": "pnpm -r typecheck",
		"build": "pnpm -r build",
		"context-map": "pnpm -r context-map",
		"docs:dev": "pnpm --filter @alveolus/docs dev",
		"docs:build": "pnpm --filter @alveolus/docs build",
		"build:packages": "pnpm -r --filter \"./packages/**\" run build",
		"changeset": "changeset",
		"release": "pnpm build:packages && changeset publish"
	},
	"devDependencies": {
		"@changesets/cli": "^3.0.3",
		"@eslint/js": "10.0.1",
		"eslint": "10.12.0",
		"oxfmt": "0.74.0",
		"typescript": "6.0.3",
		"typescript-eslint": "8.71.2"
	},
	"engines": {
		"node": ">=24"
	},
	"packageManager": "pnpm@11.1.3"
}
