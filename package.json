{
	"name": "alveolus",
	"private": true,
	"type": "module",
	"scripts": {
		"check": "oxfmt --check && oxlint --type-aware --deny-warnings",
		"check:fix": "oxfmt && oxlint --type-aware --fix",
		"test": "pnpm -r test",
		"typecheck": "pnpm -r typecheck",
		"build": "pnpm -r build",
		"context-map": "pnpm -r context-map",
		"docs:dev": "pnpm --filter @alveolus/docs dev",
		"docs:build": "pnpm --filter @alveolus/docs build",
		"build:packages": "pnpm -r --filter \"./packages/**\" run build",
		"changeset": "changeset",
		"release": "pnpm build:packages && changeset publish"
	},
	"devDependencies": {
		"@changesets/cli": "^3.0.3",
		"oxfmt": "0.74.0",
		"oxlint": "1.89.0",
		"oxlint-tsgolint": "7.0.2005"
	},
	"engines": {
		"node": ">=24"
	},
	"packageManager": "pnpm@11.1.3"
}
