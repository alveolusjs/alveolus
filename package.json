{
	"description": "Building blocks for Domain-Driven Design in TypeScript",
	"devDependencies": {
		"@biomejs/biome": "^2.5.14",
		"@changesets/cli": "^3.0.3",
		"@types/node": "^26.6.3",
		"knip": "^6.38.0",
		"tsdown": "^0.23.0",
		"typescript": "^7.0.2",
		"vitest": "^5.0.2"
	},
	"engines": {
		"node": ">=24"
	},
	"name": "alveolus",
	"packageManager": "pnpm@11.1.3",
	"private": true,
	"scripts": {
		"build": "pnpm -r --filter \"./packages/**\" run build",
		"changeset": "changeset",
		"check": "pnpm lint && pnpm typecheck && pnpm knip && pnpm test",
		"docs:build": "pnpm --filter @alveolus/docs build",
		"docs:dev": "pnpm --filter @alveolus/docs dev",
		"format": "biome format --write .",
		"knip": "knip",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"release": "pnpm build && changeset publish",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc -p tsconfig.json && pnpm -r run typecheck"
	},
	"type": "module"
}
