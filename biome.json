{
	"$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
	"assist": {
		"actions": {
			"source": {
				"organizeImports": {
					"level": "on",
					"options": {
						"groups": [
							{
								"source": ":PACKAGE:",
								"type": false
							},
							":PACKAGE:",
							":BLANK_LINE:",
							":NODE",
							{
								"source": ":NODE:",
								"type": false
							},
							":BLANK_LINE:",
							{
								"source": [":ALIAS:"],
								"type": false
							},
							":ALIAS:",
							":BLANK_LINE:",
							"**"
						]
					}
				},
				"useSortedAttributes": "on",
				"useSortedKeys": "on"
			}
		},
		"enabled": true
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"files": {
		"ignoreUnknown": true,
		"includes": [
			"**",
			"!**/node_modules",
			"!**/dist",
			"!.claude",
			"!.org",
			"!apps/api/src/shared/db/migrations",
			"!apps/api/src/shared/db/driven/pg/generated",
			"!apps/provider",
			"!docs/.c4-dist",
			"!**/routeTree.gen.ts"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineEnding": "lf",
		"lineWidth": 200
	},
	"javascript": {
		"formatter": {
			"arrowParentheses": "always",
			"bracketSameLine": false,
			"bracketSpacing": true,
			"quoteProperties": "asNeeded",
			"quoteStyle": "double",
			"semicolons": "always",
			"trailingCommas": "all"
		},
		"parser": {
			"unsafeParameterDecoratorsEnabled": true
		}
	},
	"json": {
		"formatter": {
			"enabled": true,
			"trailingCommas": "none"
		}
	},
	"linter": {
		"domains": {
			"project": "all",
			"test": "all"
		},
		"enabled": true,
		"rules": {
			"complexity": {
				"noExcessiveLinesPerFunction": {
					"level": "error",
					"options": {
						"maxLines": 50,
						"skipBlankLines": true
					}
				},
				"noStaticOnlyClass": "off",
				"noUselessCatch": "error",
				"noUselessUndefined": "error",
				"useMaxParams": {
					"level": "error",
					"options": {
						"max": 11
					}
				}
			},
			"correctness": {
				"noUndeclaredVariables": "error",
				"useImportExtensions": "off"
			},
			"performance": {
				"noAccumulatingSpread": "error",
				"noAwaitInLoops": "error",
				"noDelete": "error",
				"noDynamicNamespaceImportAccess": "error"
			},
			"style": {
				"noDefaultExport": "error",
				"noEnum": "error",
				"noExcessiveClassesPerFile": "error",
				"noExcessiveLinesPerFile": {
					"level": "error",
					"options": {
						"maxLines": 500,
						"skipBlankLines": true
					}
				},
				"noMagicNumbers": "error",
				"noNestedTernary": "error",
				"noNonNullAssertion": "error",
				"noProcessEnv": "error",
				"noRestrictedImports": {
					"level": "error",
					"options": {
						"paths": {
							"lodash": "Using lodash is forbidden"
						},
						"patterns": [
							{
								"group": ["../**"],
								"message": "Imports from parent directories are forbidden. Use aliases for imports."
							}
						]
					}
				},
				"useConsistentMemberAccessibility": {
					"level": "error",
					"options": {
						"accessibility": "explicit"
					}
				},
				"useImportType": {
					"level": "error",
					"options": {
						"style": "separatedType"
					}
				},
				"useThrowOnlyError": "error"
			},
			"suspicious": {
				"noApproximativeNumericConstant": "error",
				"noAssignInExpressions": "error",
				"noConsole": "error",
				"noConstEnum": "error",
				"noDoubleEquals": "error",
				"noEvolvingTypes": "error",
				"noExplicitAny": "error",
				"noExportsInTest": "error",
				"noFocusedTests": "error",
				"noGlobalAssign": "error",
				"noImplicitAnyLet": "error",
				"noImportCycles": "error",
				"noLabelVar": "error",
				"noSkippedTests": "error",
				"noTsIgnore": "error",
				"noUnassignedVariables": "error",
				"noUnsafeNegation": "error",
				"noVar": "error",
				"useAwait": "error",
				"useErrorMessage": "error",
				"useGetterReturn": "error",
				"useNumberToFixedDigitsArgument": "error",
				"useStrictMode": "error"
			}
		}
	},
	"overrides": [
		{
			"includes": ["packages/core/src/domain/repositories/query-repository.ts"],
			"linter": {
				"rules": {
					"correctness": {
						"noUnusedVariables": "off"
					}
				}
			}
		},
		{
			"includes": ["apps/api/src/**"],
			"linter": {
				"rules": {
					"style": {
						"useImportType": "off"
					}
				}
			}
		},
		{
			"includes": ["**/*.test.ts", "**/*.spec.ts", "**/test/**", "**/__tests__/**"],
			"linter": {
				"rules": {
					"complexity": {
						"noExcessiveLinesPerFunction": "off"
					},
					"correctness": {
						"noUndeclaredDependencies": "off"
					},
					"style": {
						"noMagicNumbers": "off",
						"noProcessEnv": "off",
						"noRestrictedImports": "off"
					},
					"suspicious": {
						"noConsole": "off"
					}
				}
			}
		},
		{
			"includes": ["**/*.config.ts", "**/*.config.js", "**/*.config.mjs"],
			"linter": {
				"rules": {
					"correctness": {
						"noUndeclaredDependencies": "off"
					},
					"style": {
						"noDefaultExport": "off"
					}
				}
			}
		},
		{
			"includes": ["apps/docs/.vitepress/**"],
			"linter": {
				"rules": {
					"style": {
						"noDefaultExport": "off"
					}
				}
			}
		},
		{
			"includes": ["**/bin/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": "off"
					}
				}
			}
		},
		{
			"includes": ["packages/*/src/**"],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": "off"
					}
				}
			}
		},
		{
			"includes": ["apps/client/**"],
			"linter": {
				"rules": {
					"complexity": {
						"noExcessiveLinesPerFunction": "off"
					},
					"correctness": {
						"noUndeclaredDependencies": "off",
						"noUnresolvedImports": "off"
					},
					"style": {
						"noDefaultExport": "off",
						"noProcessEnv": "off",
						"noRestrictedImports": "off"
					},
					"suspicious": {
						"noConsole": "off"
					}
				}
			}
		},
		{
			"includes": ["packages/arch/test/projects/**"],
			"linter": {
				"rules": {
					"correctness": {
						"noUnresolvedImports": "off"
					}
				}
			}
		}
	],
	"vcs": {
		"clientKind": "git",
		"enabled": true,
		"useIgnoreFile": true
	}
}
