		"claude-code",
		"claude-code-rules",
		"code-review",
		"ddd",
		"domain-driven-design",
		"hexagonal-architecture",
		"nestjs",
		"typescript"
	],
	"homepage": "https://alveolus.dev/start/getting-started#claude-code",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/alveolusjs/alveolus.git",
		"directory": "packages/claude-rules"
	},
	"bin": {
		"alveolus-claude": "bin/alveolus-claude.js"
	},
	"files": [
