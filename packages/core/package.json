	"name": "@alveolus/core",
	"publishConfig": {
		"exports": {
			".": "./dist/index.mjs",
			"./aggregates": "./dist/aggregates/index.mjs",
			"./command-handlers": "./dist/command-handlers/index.mjs",
			"./domain-errors": "./dist/domain-errors/index.mjs",
			"./domain-events": "./dist/domain-events/index.mjs",
