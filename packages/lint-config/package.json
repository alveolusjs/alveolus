{
	"name": "@alveolus/lint-config",
	"version": "0.2.0",
	"description": "The Alveolus rules for ESLint and dependency-cruiser: the checks a linter decides without false positives",
	"keywords": [
		"ddd",
		"dependency-cruiser",
		"domain-driven-design",
		"eslint",
		"hexagonal-architecture",
		"nestjs",
		"typescript"
	],
	"homepage": "https://alveolus.dev/",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/alveolusjs/alveolus.git",
		"directory": "packages/lint-config"
	},
	"files": [
		"dist",
		"dependency-cruiser.mjs",
		"eslint-formatter.mjs"
	],
	"type": "module",
	"sideEffects": false,
	"exports": {
		"./dependency-cruiser": {
			"@alveolus/source": "./src/dependency-cruiser.ts",
			"default": "./dist/dependency-cruiser.mjs"
		},
		"./dependency-cruiser-reporter": {
			"@alveolus/source": "./src/dependency-cruiser-reporter.ts",
			"default": "./dist/dependency-cruiser-reporter.mjs"
		},
		"./eslint": {
			"@alveolus/source": "./src/eslint.ts",
			"default": "./dist/eslint.mjs"
		},
		"./eslint-formatter": {
			"@alveolus/source": "./src/eslint-formatter.ts",
			"default": "./dist/eslint-formatter.mjs"
		},
		"./package.json": "./package.json"
	},
	"publishConfig": {
		"exports": {
			"./dependency-cruiser": "./dist/dependency-cruiser.mjs",
			"./dependency-cruiser-reporter": "./dist/dependency-cruiser-reporter.mjs",
			"./eslint": "./dist/eslint.mjs",
			"./eslint-formatter": "./dist/eslint-formatter.mjs",
			"./package.json": "./package.json"
		}
	},
	"scripts": {
		"build": "tsdown && oxfmt package.json",
		"test": "vitest run",
		"typecheck": "tsc -p tsconfig.json"
	},
	"devDependencies": {
		"@types/node": "26.6.3",
		"dependency-cruiser": "18.7.0",
		"eslint": "10.12.0",
		"gray-matter": "^4.0.3",
		"tsdown": "0.23.0",
		"typescript": "6.0.3",
		"typescript-eslint": "8.71.2",
		"vite": "8.3.1",
		"vitest": "5.0.2"
	},
	"peerDependencies": {
		"dependency-cruiser": ">=18.7.0",
		"eslint": ">=10.0.0",
		"typescript": ">=5.8.0",
		"typescript-eslint": ">=8.71.0"
	},
	"peerDependenciesMeta": {
		"dependency-cruiser": {
			"optional": true
		},
		"eslint": {
			"optional": true
		},
		"typescript-eslint": {
			"optional": true
		},
		"typescript": {
			"optional": true
		}
	},
	"engines": {
		"node": ">=24"
	}
}
