{
	"bin": {
		"alveolus": "./src/bin.ts"
	},
	"dependencies": {
		"commander": "^15.0.0",
		"jiti": "^2.7.0",
		"picocolors": "^1.1.1",
		"ts-morph": "^28.0.0",
		"zod": "^4.6.5"
	},
	"description": "Architecture checks that keep a Domain-Driven Design project from drifting",
	"devDependencies": {
		"@alveolus/core": "workspace:*"
	},
	"engines": {
		"node": ">=24"
	},
	"exports": {
		".": {
			"@alveolus/source": "./src/index.ts",
			"default": "./dist/index.mjs"
		},
		"./bin": {
			"@alveolus/source": "./src/bin.ts",
			"default": "./dist/bin.mjs"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist",
		"docs"
	],
	"homepage": "https://alveolus.dev/",
	"keywords": [
		"ddd",
		"domain-driven-design",
		"typescript",
		"architecture",
		"architecture-testing",
		"linter",
		"bounded-context",
		"hexagonal-architecture",
		"clean-architecture",
		"dependency-rules",
		"cli"
	],
	"license": "MIT",
	"name": "@alveolus/arch",
	"publishConfig": {
		"bin": {
			"alveolus": "./dist/bin.mjs"
		},
		"exports": {
			".": "./dist/index.mjs",
			"./bin": "./dist/bin.mjs",
			"./package.json": "./package.json"
		}
	},
	"repository": {
		"directory": "packages/arch",
		"type": "git",
		"url": "git+https://github.com/alveolusjs/alveolus.git"
	},
	"scripts": {
		"build": "tsdown && biome check --write package.json",
		"typecheck": "tsc -p tsconfig.json"
	},
	"sideEffects": false,
	"type": "module",
	"version": "0.3.0"
}
