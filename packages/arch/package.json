		"bin": {
			"alveolus": "./dist/bin.mjs"
		},
		"exports": {
			".": "./dist/index.mjs",
			"./bin": "./dist/bin.mjs",
			"./package.json": "./package.json"
		}
	},
	"repository": {
		"directory": "packages/arch",
		"type": "git",
		"url": "git+https://github.com/alveolusjs/alveolus.git"
	},
	"scripts": {
		"build": "tsdown",
		"typecheck": "tsc -p tsconfig.json"
	},
	"type": "module",
	"version": "0.1.0-alpha.0"
}
