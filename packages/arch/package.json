{
	"bin": {
		"alveolus": "./src/bin.ts"
	},
	"dependencies": {
		"commander": "^15.0.0",
		"jiti": "^2.7.0",
		"picocolors": "^1.1.1",
		"ts-morph": "^28.0.0",
		"zod": "^4.6.5"
	},
	"description": "Architecture checks that keep a Domain-Driven Design project from drifting",
	"devDependencies": {
		"@alveolus/core": "workspace:*"
