{
	"description": "Fitness functions that check an app against the Alveolus rules, from its tests",
	"engines": {
		"node": ">=24"
	},
	"exports": {
		".": {
			"@alveolus/source": "./src/index.ts",
			"default": "./dist/index.mjs"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist"
	],
	"homepage": "https://alveolus.dev/",
	"keywords": [
		"ddd",
		"domain-driven-design",
		"typescript",
		"fitness-functions",
		"architecture",
		"architecture-testing",
		"hexagonal-architecture"
	],
	"license": "MIT",
	"name": "@alveolus/fitness-functions",
	"publishConfig": {
		"exports": {
			".": "./dist/index.mjs",
			"./package.json": "./package.json"
		}
	},
	"repository": {
		"directory": "packages/fitness-functions",
		"type": "git",
		"url": "git+https://github.com/alveolusjs/alveolus.git"
	},
	"scripts": {
		"build": "tsdown && biome check --write package.json",
		"test": "vitest run",
		"typecheck": "tsc -p tsconfig.json"
	},
	"sideEffects": false,
	"type": "module",
	"version": "0.0.0",
	"devDependencies": {
		"@types/node": "26.6.3",
		"gray-matter": "^4.0.3",
		"tsdown": "0.23.0",
		"typescript": "7.0.2",
		"vite": "8.3.1",
		"vitest": "5.0.2"
	},
	"dependencies": {
		"oxc-parser": "0.155.0",
		"oxc-resolver": "^11.24.2"
	}
}
